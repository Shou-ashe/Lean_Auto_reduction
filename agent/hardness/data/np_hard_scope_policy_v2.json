      "failure_code": "encoding_polynomial_reverse_bridge_unavailable",
      "identity_id": "sha256:1e1d552d56d5dfa046f124c8e9948413642b5c7ae6376967401277a444f70967",
      "problem_node_id": "lean-whnf:3355734332",
      "public_source_file": "Lean/Reference/ComplexityReduction/Presentation/Knapsack.lean",
      "rationale": "The canonical target uses unaryNat payloads.  The public library certifies unary-to-binary normalization, but the v1 task proposed the reverse binary-hardness-to-unary direction.  Expanding a binary integer to unary is not polynomial in the binary input length, so that reverse representation bridge cannot be assumed by this benchmark.  This is a benchmark/formalization boundary, not a claim that the decision predicate is tractable.",
      "representation_node_id": "lean-whnf:2214801589",
      "schema_version": "hardness_np_hard_scope_policy_entry_v2",
      "semantic_evidence_declaration": "ComplexityReduction.Presentation.Knapsack.structuredProblem_accepts"
    },
    {
