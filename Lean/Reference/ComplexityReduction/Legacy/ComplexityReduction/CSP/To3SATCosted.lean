import Mathlib.Data.Fintype.BigOperators
import Mathlib.Algebra.Order.BigOperators.Group.List
import ComplexityReduction.Legacy.ComplexityReduction.Certificates
import ComplexityReduction.Legacy.ComplexityReduction.CSP.To3SAT
