{
  "schema_version": "hardness_stage_p_lean_worker_microbenchmark_v1",
  "benchmark_id": "stage-p-isolated-readonly-contract-probe-20x",
  "repeat_count": 20,
  "maximum_workers": 4,
  "command_profile": {
    "forced_cold": ["lake", "env", "lean", "<fresh-isolated-candidate.lean>"],
    "persistent": ["stage-p-lean-worker", "validate", "<complete-content-key>"],
    "final_authority": ["lake", "env", "lean", "<final-combined.lean>"],
    "release_authority": ["lake", "env", "lean", "<independent-release-replay.lean>"]
  },
  "cache_key_fields": [
    "toolchain",
    "lake_manifest",
    "base_registry_fingerprint",
    "complete_source_hash",
    "dependency_hash",
    "namespace",
    "session_id",
    "editable_allowlist",
    "validation_profile"
  ],
  "isolation_checks": [
    "session_ownership",
    "namespace_isolation",
    "dependency_invalidation",
    "candidate_invalidation",
    "registry_invalidation",
    "toolchain_invalidation",
    "stale_olean_rejection",
    "deletion_after_cache",
    "worker_restart",
    "worker_crash_cold_fallback"
  ],
  "gates": {
    "warm_p50_over_cold_p50_max": 0.5,
    "wall_time_reduction_min": 0.5,
    "cache_invalidation_rate_min": 1.0,
    "namespace_isolation_rate_min": 1.0,
    "stale_result_rejection_rate_min": 1.0
  }
}
